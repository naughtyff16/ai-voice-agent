# Copy to backend/.env.local (git-ignored) for local development.
# ENVIRONMENT=local must be set in the shell itself: it decides whether this
# file is read at all, so it cannot be defined here.

# Runtime identity: the least-privileged app_api role, never the bootstrap or migration role.
DATABASE__URL=postgresql+asyncpg://app_api:<password>@127.0.0.1:54320/voice_agent_dev
REDIS__URL=redis://:<password>@127.0.0.1:63790/0

OBSERVABILITY__LOG_FORMAT=console
OBSERVABILITY__LOG_LEVEL=INFO

# Explicit browser origins for a local frontend, as a JSON list. Empty = none.
API__CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
API__DOCS_ENABLED=true

# Used only by scripts/db_migrate.py (administrative bootstrap identity):
# MIGRATION_DATABASE_URL=postgresql+psycopg://voice_agent_bootstrap:<password>@127.0.0.1:54320/voice_agent_dev
