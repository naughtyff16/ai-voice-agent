    subgraph FE["frontend/ - Next.js App Router (3A §4)"]
        WEB["apps/web dashboard, call log, agents<br/>TanStack Query, Zustand, shadcn/ui<br/>[PLANNED W1-W2, D8]"]:::planned
    end

    subgraph DEPLOY["backend/voice_agent/apps - deployables of one codebase"]
        API["apps/api - Core REST API<br/>factory, health, middleware, error catalog<br/>[BUILT D0] routes [PLANNED]"]:::built
        CBI["callback ingress 6D-021 (in apps/api)<br/>verify raw body, tenant from platform state,<br/>receipt + encrypted input, then 2xx<br/>[BLOCKED: OD-W0-12, OD-W0-13]"]:::blocked
