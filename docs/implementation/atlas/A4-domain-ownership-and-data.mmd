%% A4 — Domain Ownership and Data Architecture (W0 / 8A Architecture Atlas)
%% Each box = one bounded context, its PostgreSQL schema(s) and its data classes. All tenant tables carry
%% organization_id with ENABLE + FORCE ROW LEVEL SECURITY on organization.current_tenant_id() (5A; 001_5B), except
%% organization.organizations, which has no RLS (7L §2.4).
%% Streams: exactly the eleven logical durable streams and the one SIGNAL stream of 7E §18 / §29.3. Producers per the
%% 7E stream table (owner of each stream family). Arrows stream -> group = the 18 (group, stream) subscriptions of
%% 7E §29.3 for the 11 durable groups, plus the one best-effort SIGNAL subscription.
%% Every durable stream is CLOSED for publication until all its owed groups are admitted (SPA-7L-01 .. -16, AG-7L-06;
%% owner decision OD-W0-10 applies this to every environment). The SIGNAL group is best effort, not SPA-gated, and no
%% Billing group or billable effect exists on LS-S-VOX (7E §29.3; 7L §34.5.2).
%% Revised 2026-10-16 for the first independent review (M-W0-02, P1-W0-03).
flowchart LR
    classDef built fill:#d6f5d6,stroke:#2e7d32,color:#1b5e20
    classDef planned fill:#dbe9ff,stroke:#1e4e9c,color:#0d2b5e
    classDef blocked fill:#ffe0e0,stroke:#c62828,color:#7f0000,stroke-dasharray:5 3
    classDef stream fill:#fff3cd,stroke:#a66f00,color:#4a3200
    classDef signal fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c,stroke-dasharray:4 2

    subgraph IAM["Identity, Organization, Compliance - 5B / 6B / 6C"]
        ID["identity.*, organization.*<br/>users, sessions, api_keys, memberships, roles,<br/>compliance_policies, data_subject_requests<br/>credential hashes only [BUILT]"]:::built
    end
    subgraph VOXC["Voice and AI Agent - 5C / 6D / 6E"]
        VO["voice.* calls<br/>call_sessions, conversations, turns, transcripts,<br/>recordings, tenant_phone_numbers<br/>pii:phone, pii:voice, sensitive media [BUILT]"]:::built
        AGP["voice.* agents (6E owner)<br/>agents, agent_versions, tool_definitions [BUILT]"]:::built
    end
    subgraph AIX["Prompt, Memory, Workflow - 5G / 6E / 6I"]
        PG5["prompt.*, memory.*, workflow.*<br/>memory summaries pii:voice (LR-17) [BUILT]"]:::built
    end
    subgraph KNWC["Knowledge - 5F / 6F"]
        KB["knowledge.*<br/>documents, chunks (pgvector) [BUILT]"]:::built
    end
    subgraph CRMC["CRM - 5D / 6G"]
        CR["crm.*<br/>contacts, consent, suppressions, deals<br/>pii:contact [BUILT]"]:::built
    end
    subgraph CPNC["Campaign - 5E / 6H"]
        CA["campaign.*<br/>campaigns, contacts, call_jobs, imports [BUILT]"]:::built
    end
    subgraph BILC["Billing - 5H / 6K"]
        BI["billing.*<br/>plans, subscriptions, quotas, usage_events,<br/>invoices, payments, credits<br/>financial, server-authoritative [BUILT]"]:::built
    end
    subgraph INTC["Integrations - 5I / 6J"]
        IN["integrations.*, webhooks.*, plugins.*<br/>endpoints, deliveries, inbound callbacks<br/>secret refs only [BUILT]"]:::built
    end
    subgraph ANX["Analytics and Audit - 5J / 6L"]
        AN["analytics.*, audit.*<br/>projections, audit_events (hash chain),<br/>domain_event_outbox [BUILT]"]:::built
    end

    S_IDN[["LS-D-IDN<br/>owes 1 group"]]:::stream
